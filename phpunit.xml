<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- Tests never inherit the real site's switches or payment keys from .env;
             tests that need them set them explicitly. -->
        <env name="CATALOGUE_LIVE" value="false"/>
        <env name="RAZORPAY_MODE" value="test"/>
        <env name="RAZORPAY_KEY_ID" value=""/>
        <env name="RAZORPAY_KEY_SECRET" value=""/>
        <env name="RAZORPAY_WEBHOOK_SECRET" value=""/>
        <env name="RAZORPAY_CURRENCY" value=""/>
        <env name="ESIMGO_API_URL" value="https://api.esim-go.com/v2.5"/>
        <env name="ESIMGO_API_KEY" value=""/>
        <env name="ESIMGO_CURRENCY" value=""/>
        <env name="ESIMGO_FULFILMENT_ENABLED" value="false"/>
        <env name="ESIMGO_FULFILMENT_ALLOW_TEST_PAYMENTS" value="false"/>
        <!-- Test runs never write to the real storage/logs/laravel.log. Log events
             are still dispatched, so tests can assert what would be logged. -->
        <env name="LOG_CHANNEL" value="null"/>
        <env name="LOG_DEPRECATIONS_CHANNEL" value="null"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
